{
  "name": "adders-entertainment-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:server": "npm run build && wrangler pages dev ./dist",
    "db:init": "wrangler d1 execute adders-db --local --file=./schema.sql",
    "db:seed": "wrangler d1 execute adders-db --local --file=./seed-admin.sql",
    "db:init:remote": "wrangler d1 execute adders-db --remote --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute adders-db --remote --file=./seed-admin.sql"
  },
  "dependencies": {
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.2",
    "wrangler": "^3.78.0"
  }
}
